// One shared database for both sister companies.
// Every company-owned record carries a companyId so data stays separated.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Supabase Postgres
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id        String   @id @default(cuid())
  slug      String   @unique // "xpert-marine" | "eliche-radice"
  name      String
  createdAt DateTime @default(now())

  // Letterhead details printed on offers (edited on the Company details page).
  legalName          String?
  address            String?
  phone              String?
  email              String?
  website            String?
  taxNumber          String? // VAT / MOF number
  registrationNumber String? // commercial register
  bankDetails        String?
  offerTerms         String? // default terms & conditions for new offers
  labourCostPerHour  Decimal @default(0) @db.Decimal(10, 2) // what an hour of workshop labour costs the company

  users            User[]
  purchases        Purchase[]
  stockMovements   StockMovement[]
  offers           Offer[]
  invoices         Invoice[]
  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]
  ledgerAccounts   LedgerAccount[]
  journalEntries   JournalEntry[]
  receipts         CustomerReceipt[]
  vouchers         Voucher[]
  creditNotes      CreditNote[]
  exchangeRates    ExchangeRate[]
  posShifts        PosShift[]
  posSales         PosSale[]
  posRefunds       PosRefund[]
  employees        Employee[]
  payrollRuns      PayrollRun[]
  jobCards         JobCard[]
  warranties       Warranty[]
  stockCounts      StockCount[]
  transfersOut     StockTransfer[]      @relation("TransferFrom")
  transfersIn      StockTransfer[]      @relation("TransferTo")
  serials          ProductSerial[]
  cheques          Cheque[]
  reconciliations  BankReconciliation[]
  appointments     Appointment[]
  payrollSettings  PayrollSettings?
  offerClauses     OfferClause[]
  posSettings      PosSettings?
  websiteSettings  WebsiteSettings?
  websiteServices  WebsiteService[]
  websiteGallery   WebsiteGalleryItem[]
  websiteListings  WebsiteListing[]
  websiteImages    WebsiteImage[]
  websiteMessages  WebsiteMessage[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  // See src/lib/permissions.ts for the list of roles.
  role         String
  // null only for ADMIN (group-wide). Everyone else belongs to exactly one company.
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  active       Boolean   @default(true)
  // Custom access set on the Team page: { modules: [...], caps: [...] }. null = the role's defaults.
  permissions  Json?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  purchases        Purchase[]
  offers           Offer[]
  invoices         Invoice[]
  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]
  journalEntries   JournalEntry[]
  receipts         CustomerReceipt[]
  vouchers         Voucher[]
  creditNotes      CreditNote[]
  exchangeRates    ExchangeRate[]
  posShifts        PosShift[]
  posSales         PosSale[]
  posRefunds       PosRefund[]
  payrollRuns      PayrollRun[]
  jobCards         JobCard[]
  warranties       Warranty[]
  stockCounts      StockCount[]
  transfersMade    StockTransfer[]      @relation("TransferCreatedBy")
  transfersTaken   StockTransfer[]      @relation("TransferReceivedBy")
  cheques          Cheque[]
  reconciliations  BankReconciliation[]

  @@index([companyId])
}

// ─── Sales: customers and offers ───────────────────────────
// Customers are shared by both companies; offers belong to one company.

model Customer {
  id          String   @id @default(cuid())
  name        String   @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  taxNumber   String?
  notes       String?
  pdfLanguage String   @default("EN") // EN | EN_AR (bilingual documents)
  portalToken String?  @unique // private link to the customer portal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serials      ProductSerial[]
  cheques      Cheque[]
  offers       Offer[]
  invoices     Invoice[]
  receipts     CustomerReceipt[]
  creditNotes  CreditNote[]
  journalLines JournalLine[]
  posSales     PosSale[]
  vessels      Vessel[]
  jobCards     JobCard[]
  warranties   Warranty[]
  appointments Appointment[]
}

model Offer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  number    String  @unique // e.g. XM-OF-2026-0001

  // Customer details are copied onto the offer so a sent offer never changes.
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String
  customerAttention String?
  customerAddress   String?
  customerEmail     String?
  customerPhone     String?

  subject    String?
  reference  String? // customer's RFQ / tender reference
  offerDate  DateTime @db.Date
  validUntil DateTime @db.Date
  status     String   @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED
  marking    String? // e.g. "COMMERCIAL IN CONFIDENCE", printed on every page
  intro      String?
  terms      String?
  notes      String? // internal, never printed

  discountType  String  @default("PERCENT") // PERCENT | AMOUNT
  discountValue Decimal @default(0) @db.Decimal(12, 2)
  applyVat      Boolean @default(true)

  // How the payment schedule is defined: FULL (one payment), PERCENT (e.g. 60 / 40)
  // or INSTALLMENTS (N equal payments, calculated).
  paymentPlan String @default("FULL")

  subtotal      Decimal @db.Decimal(12, 2) // lines after line discounts
  discountTotal Decimal @db.Decimal(12, 2) // overall discount amount
  totalHT       Decimal @db.Decimal(12, 2)
  vatAmount     Decimal @db.Decimal(12, 2)
  totalTTC      Decimal @db.Decimal(12, 2)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vesselId String?
  vessel   Vessel? @relation(fields: [vesselId], references: [id], onDelete: SetNull)

  // Online approval through a private link.
  shareToken    String?   @unique
  respondedAt   DateTime?
  respondedName String?
  customerNote  String?

  lines         OfferLine[]
  paymentTerms  OfferPaymentTerm[]
  invoices      Invoice[]
  jobCards      JobCard[]
  incoterm      String? // EXW, FCA, CIF, DAP, DDP…
  deliveryPlace String?
  leadTime      String? // e.g. 4–6 weeks from order
  warranty      String? // e.g. 12 months parts and labour
  revision      Int                @default(0) // 0 = original, 1 = Rev. 1…
  revisionOf    String? // id of the offer this one revises

  @@index([companyId, offerDate])
}

model OfferLine {
  id              String   @id @default(cuid())
  offerId         String
  offer           Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  position        Int
  kind            String // ITEM | SECTION (a heading row)
  productId       String? // catalogue item it came from, if any
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  code            String?
  title           String
  description     String?
  quantity        Decimal  @default(0) @db.Decimal(12, 2)
  unit            String?
  unitPrice       Decimal  @default(0) @db.Decimal(12, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal  @default(0) @db.Decimal(12, 2)

  @@index([offerId])
}

// ─── Inventory ─────────────────────────────────────────────
// Suppliers and products are shared by both companies.
// Purchases and stock belong to one company.

model Supplier {
  cheques       Cheque[]
  id            String   @id @default(cuid())
  name          String   @unique
  accountNumber String? // the supplier's account / reference in our books
  phone         String?
  email         String?
  address       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products       Product[]
  purchases      Purchase[]
  purchaseOrders PurchaseOrder[]
  journalLines   JournalLine[]
}

// Catalogue item: a stocked product or a service (labour, repair…).
// Both share the 4-digit code sequence so a code never means two things.
// Services have no stock, barcodes or minimum quantity.
model Product {
  id           String    @id @default(cuid())
  code         String    @unique // 4 digits, generated
  type         String    @default("PRODUCT") // "PRODUCT" | "SERVICE"
  unit         String? // services: "HOUR" | "FIXED" | "DAY" | "UNIT"
  name         String
  description  String?
  imageUrl     String?
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  // Price without VAT. The TTC price is derived (see src/lib/money.ts).
  priceHT      Decimal   @db.Decimal(12, 2)
  // Shop (POS) price without VAT, when the counter sells at a different price. Null = priceHT.
  posPriceHT   Decimal?  @db.Decimal(12, 4) // 4 decimals so the price incl. VAT is exact
  minQuantity  Int       @default(0)
  active       Boolean   @default(true)
  trackSerials Boolean   @default(false) // engines, outboards…: each unit has a serial number
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  serials            ProductSerial[]
  barcodes           ProductBarcode[]
  purchaseItems      PurchaseItem[]
  stockMovements     StockMovement[]
  offerLines         OfferLine[]
  purchaseOrderLines PurchaseOrderLine[]
  posSaleLines       PosSaleLine[]
  jobCardLines       JobCardLine[]
  warranties         Warranty[]
  stockCountLines    StockCountLine[]
  transferLines      StockTransferLine[]
  websiteListings    WebsiteListing[]

  @@index([name])
  @@index([type])
}

model ProductBarcode {
  id        String  @id @default(cuid())
  code      String  @unique
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Purchase {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  supplierId    String
  supplier      Supplier  @relation(fields: [supplierId], references: [id])
  invoiceNumber String
  reference     String?
  purchaseDate  DateTime  @db.Date
  dueDate       DateTime? @db.Date // when the supplier must be paid (defaults to the invoice date)
  subtotalHT    Decimal   @db.Decimal(12, 2) // sum of lines, before discount
  discount      Decimal   @default(0) @db.Decimal(12, 2) // amount, without VAT
  totalHT       Decimal   @db.Decimal(12, 2) // after discount
  vatAmount     Decimal   @db.Decimal(12, 2)
  totalTTC      Decimal   @db.Decimal(12, 2)
  notes         String?
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

  items          PurchaseItem[]
  stockMovements StockMovement[]
  purchaseOrder  PurchaseOrder?
  payments       SupplierPayment[]
  landedCosts    LandedCost[]
  serials        ProductSerial[]

  @@unique([companyId, supplierId, invoiceNumber])
  @@index([companyId, purchaseDate])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPriceHT Decimal  @db.Decimal(12, 2)
  lineTotalHT Decimal  @db.Decimal(12, 2)
  unitCost    Decimal? @db.Decimal(12, 4) // after discount + landed costs (freight, customs…)

  @@index([purchaseId])
  @@index([productId])
}

// Every stock change is a row; current stock = sum of quantity per company + product.
// Purchases add stock now; sales will subtract it later.
model StockMovement {
  id           String         @id @default(cuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  quantity     Int // positive = in, negative = out
  type         String // "PURCHASE" | "POS_SALE" | "POS_RETURN"
  purchaseId   String?
  purchase     Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  posSaleId    String?
  posSale      PosSale?       @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  posRefundId  String?
  posRefund    PosRefund?     @relation(fields: [posRefundId], references: [id], onDelete: Cascade)
  jobCardId    String?
  jobCard      JobCard?       @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  stockCountId String?
  stockCount   StockCount?    @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  transferId   String?
  transfer     StockTransfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  @@index([companyId, productId])
}

// One row of an offer payment schedule. Amounts include VAT (what the customer pays).
model OfferPaymentTerm {
  id       String  @id @default(cuid())
  offerId  String
  offer    Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  position Int
  label    String
  mode     String // PERCENT | BALANCE (remainder: last of N equal payments)
  value    Decimal @db.Decimal(14, 4) // the % typed in (or 100 / N)
  percent  Decimal @db.Decimal(9, 4) // calculated share of the offer total
  amount   Decimal @db.Decimal(12, 2) // calculated amount incl. VAT
  dueDays  Int     @default(0) // payment due N days after the invoice date

  invoices Invoice[]

  @@index([offerId])
}

model Invoice {
  id            String            @id @default(cuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id])
  number        String            @unique // e.g. XM-INV-2026-0001
  offerId       String?
  offer         Offer?            @relation(fields: [offerId], references: [id], onDelete: SetNull)
  paymentTermId String?
  paymentTerm   OfferPaymentTerm? @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)

  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String
  customerAttention String?
  customerAddress   String?
  customerEmail     String?
  customerPhone     String?
  customerTaxNumber String?

  subject     String?
  reference   String? // customer PO / reference
  invoiceDate DateTime  @db.Date
  dueDate     DateTime  @db.Date
  status      String    @default("ISSUED") // ISSUED | PAID | CANCELLED
  paidAt      DateTime?
  marking     String?
  notes       String? // printed under the lines

  applyVat  Boolean
  totalHT   Decimal  @db.Decimal(12, 2)
  vatAmount Decimal  @db.Decimal(12, 2)
  lbpRate   Decimal? @db.Decimal(14, 2) // LBP per USD on the day it was issued: the VAT is printed in LBP at this rate
  totalTTC  Decimal  @db.Decimal(12, 2)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vesselId  String?
  vessel    Vessel?  @relation(fields: [vesselId], references: [id], onDelete: SetNull)
  jobCardId String?
  jobCard   JobCard? @relation("JobCardInvoices", fields: [jobCardId], references: [id], onDelete: SetNull)

  lines        InvoiceLine[]
  receipts     CustomerReceipt[]
  creditNotes  CreditNote[]
  jobCardLines JobCardLine[]

  @@index([companyId, invoiceDate])
  @@index([offerId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  description String?
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2) // excl. VAT
  lineTotal   Decimal @db.Decimal(12, 2) // excl. VAT

  @@index([invoiceId])
}

// ─── Purchase orders ───────────────────────────────────────
// Sent to a supplier before the goods arrive. Receiving one creates a Purchase (stock in).

model PurchaseOrder {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  number       String    @unique // e.g. XM-PO-2026-0001
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  orderDate    DateTime  @db.Date
  expectedDate DateTime? @db.Date // expected delivery
  status       String    @default("DRAFT") // DRAFT | SENT | RECEIVED | CANCELLED
  reference    String?
  terms        String? // delivery / payment terms printed on the PDF
  notes        String? // internal, never printed
  subtotalHT   Decimal   @db.Decimal(12, 2)
  discount     Decimal   @default(0) @db.Decimal(12, 2)
  totalHT      Decimal   @db.Decimal(12, 2)
  vatAmount    Decimal   @db.Decimal(12, 2)
  totalTTC     Decimal   @db.Decimal(12, 2)

  // The purchase created when the goods were received.
  purchaseId String?   @unique
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines PurchaseOrderLine[]

  @@index([companyId, orderDate])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  position        Int
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitPriceHT     Decimal       @db.Decimal(12, 2)
  lineTotalHT     Decimal       @db.Decimal(12, 2)

  @@index([purchaseOrderId])
  @@index([productId])
}

// ─── Accounting ────────────────────────────────────────────
// A payment made to a supplier against a purchase (several per purchase = partial payments).
model SupplierPayment {
  cheques         Cheque[]
  id              String         @id @default(cuid())
  companyId       String
  number          String? // PV-2026-0001: same series as payment vouchers
  // Cancelled instead of deleted: the record stays, a reversing journal entry is posted.
  status          String         @default("POSTED") // POSTED | CANCELLED
  cancelledAt     DateTime?
  cancelledByName String?
  cancelReason    String?
  company         Company        @relation(fields: [companyId], references: [id])
  purchaseId      String
  purchase        Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  amount          Decimal        @db.Decimal(12, 2)
  paidAt          DateTime       @db.Date
  method          String // CASH | BANK_TRANSFER | CHEQUE | CARD | OTHER
  // Cash box or bank account it was paid from (null only for payments made before the ledger).
  moneyAccountId  String?
  moneyAccount    LedgerAccount? @relation(fields: [moneyAccountId], references: [id])
  reference       String? // transfer / cheque number
  notes           String?
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())

  @@unique([companyId, number])
  @@index([companyId, paidAt])
  @@index([purchaseId])
}

// ─── General ledger (double entry) ─────────────────────────
// Every document posts a journal entry; reports read the journal lines.

model LedgerAccount {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String // e.g. 530 Cash, 411 Customers (Lebanese chart numbering)
  name      String
  type      String // ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  kind      String // CASH | BANK | RECEIVABLE | PAYABLE | VAT_IN | VAT_OUT | SALES | PURCHASES | EXPENSE | INCOME | CAPITAL | OTHER
  isSystem  Boolean  @default(false) // used by automatic postings, so it cannot be deleted
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  lines              JournalLine[]
  receipts           CustomerReceipt[]
  supplierPayments   SupplierPayment[]
  voucherMoney       Voucher[]            @relation("VoucherMoneyAccount")
  voucherCounterpart Voucher[]            @relation("VoucherCounterAccount")
  payrollRuns        PayrollRun[]
  cheques            Cheque[]
  reconciliations    BankReconciliation[]

  @@unique([companyId, code])
  @@index([companyId, kind])
}

model JournalEntry {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  number      String // JV-2026-00001
  date        DateTime @db.Date
  memo        String
  sourceType  String // INVOICE | CREDIT_NOTE | PURCHASE | SUPPLIER_PAYMENT | RECEIPT | VOUCHER | MANUAL | REVERSAL
  sourceId    String?
  reversalOf  String? // entry id this one reverses
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  lines JournalLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id               String              @id @default(cuid())
  entryId          String
  entry            JournalEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId        String
  account          LedgerAccount       @relation(fields: [accountId], references: [id])
  debit            Decimal             @default(0) @db.Decimal(14, 2)
  credit           Decimal             @default(0) @db.Decimal(14, 2)
  description      String?
  // Partner tags for statements of account.
  customerId       String?
  customer         Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String?
  supplierId       String?
  supplier         Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  reconciliationId String?
  reconciliation   BankReconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)

  @@index([entryId])
  @@index([accountId])
  @@index([customerId])
  @@index([supplierId])
}

// Money received from a customer, usually against an invoice (partial allowed).
model CustomerReceipt {
  cheques         Cheque[]
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  number          String // RC-2026-0001
  // Cancelled instead of deleted: the record stays, a reversing journal entry is posted.
  status          String        @default("POSTED") // POSTED | CANCELLED
  cancelledAt     DateTime?
  cancelledByName String?
  cancelReason    String?
  invoiceId       String?
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  amount          Decimal       @db.Decimal(12, 2)
  receivedAt      DateTime      @db.Date
  method          String // CASH | BANK_TRANSFER | CHEQUE | CARD | OTHER
  moneyAccountId  String
  moneyAccount    LedgerAccount @relation(fields: [moneyAccountId], references: [id])
  reference       String?
  notes           String?
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  @@unique([companyId, number])
  @@index([companyId, receivedAt])
  @@index([invoiceId])
}

// PV (money out: expenses, other payments), RV (money in: capital, loans, other income),
// TR (transfer between cash/bank accounts).
model Voucher {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id])
  number           String // PV-2026-0001 | RV-2026-0001 | TR-2026-0001
  kind             String // PAYMENT | RECEIPT | TRANSFER
  // Cancelled instead of deleted: the record stays, a reversing journal entry is posted.
  status           String        @default("POSTED") // POSTED | CANCELLED
  cancelledAt      DateTime?
  cancelledByName  String?
  cancelReason     String?
  date             DateTime      @db.Date
  moneyAccountId   String // cash/bank paid from (PV, TR source) or received into (RV)
  moneyAccount     LedgerAccount @relation("VoucherMoneyAccount", fields: [moneyAccountId], references: [id])
  counterAccountId String // expense / income / capital account, or TR destination
  counterAccount   LedgerAccount @relation("VoucherCounterAccount", fields: [counterAccountId], references: [id])
  partyName        String? // paid to / received from
  description      String
  amountHT         Decimal       @db.Decimal(12, 2)
  vatAmount        Decimal       @default(0) @db.Decimal(12, 2) // recoverable VAT on an expense
  amount           Decimal       @db.Decimal(12, 2) // total moved
  method           String
  reference        String?
  createdById      String
  createdBy        User          @relation(fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())

  @@unique([companyId, number])
  @@index([companyId, date])
}

model CreditNote {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  number            String // CN-2026-0001
  invoiceId         String?
  invoice           Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String
  customerAddress   String?
  customerTaxNumber String?
  date              DateTime  @db.Date
  reason            String
  status            String    @default("ISSUED") // ISSUED | CANCELLED
  applyVat          Boolean
  totalHT           Decimal   @db.Decimal(12, 2)
  vatAmount         Decimal   @db.Decimal(12, 2)
  lbpRate           Decimal?  @db.Decimal(14, 2) // LBP per USD on the day it was issued: the VAT is printed in LBP at this rate
  totalTTC          Decimal   @db.Decimal(12, 2)
  createdById       String
  createdBy         User      @relation(fields: [createdById], references: [id])
  createdAt         DateTime  @default(now())

  lines CreditNoteLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([invoiceId])
}

model CreditNoteLine {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  position     Int
  title        String
  quantity     Decimal    @db.Decimal(12, 2)
  unitPrice    Decimal    @db.Decimal(12, 2) // excl. VAT
  lineTotal    Decimal    @db.Decimal(12, 2) // excl. VAT

  @@index([creditNoteId])
}

// Gap-free document numbers per company and series (e.g. "PV-2026").
model DocumentCounter {
  companyId String
  series    String
  value     Int    @default(0)

  @@id([companyId, series])
}

// ── Point of sale (retail counter) ──

/**
 * LBP per USD set by a manager; the POS uses the latest one.
 */
model ExchangeRate {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  lbpPerUsd Decimal  @db.Decimal(14, 2)
  setById   String
  setBy     User     @relation(fields: [setById], references: [id])
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

/**
 * A cashier's session at the till: opening float, then counted cash at closing.
 */
model PosShift {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  number      String // SH-2026-0001
  cashierId   String
  cashier     User      @relation(fields: [cashierId], references: [id])
  status      String    @default("OPEN") // OPEN | CLOSED
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openingUsd  Decimal   @db.Decimal(12, 2)
  openingLbp  Decimal   @db.Decimal(16, 0)
  expectedUsd Decimal?  @db.Decimal(12, 2)
  expectedLbp Decimal?  @db.Decimal(16, 0)
  countedUsd  Decimal?  @db.Decimal(12, 2)
  countedLbp  Decimal?  @db.Decimal(16, 0)
  closeRate   Decimal?  @db.Decimal(14, 2)
  notes       String?

  sales   PosSale[]
  refunds PosRefund[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

/**
 * A counter sale. Amounts are USD; cash may be paid in USD and/or LBP at the sale's rate.
 */
model PosSale {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  number            String // POS-2026-00001
  shiftId           String
  shift             PosShift  @relation(fields: [shiftId], references: [id])
  cashierId         String
  cashier           User      @relation(fields: [cashierId], references: [id])
  saleDate          DateTime  @db.Date
  createdAt         DateTime  @default(now())
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String    @default("Walk-in customer")
  customerAddress   String?
  customerTaxNumber String?
  subtotalHT        Decimal   @db.Decimal(12, 2)
  discountPct       Decimal   @default(0) @db.Decimal(5, 2)
  discountHT        Decimal   @default(0) @db.Decimal(12, 2)
  totalHT           Decimal   @db.Decimal(12, 2)
  vatAmount         Decimal   @db.Decimal(12, 2)
  totalTTC          Decimal   @db.Decimal(12, 2)
  rate              Decimal   @db.Decimal(14, 2) // LBP per USD
  paidUsd           Decimal   @default(0) @db.Decimal(12, 2)
  paidLbp           Decimal   @default(0) @db.Decimal(16, 0)
  paidCard          Decimal   @default(0) @db.Decimal(12, 2)
  changeUsd         Decimal   @default(0) @db.Decimal(12, 2)
  changeLbp         Decimal   @default(0) @db.Decimal(16, 0)
  status            String    @default("COMPLETED") // COMPLETED | PARTLY_REFUNDED | REFUNDED

  lines          PosSaleLine[]
  refunds        PosRefund[]
  stockMovements StockMovement[]

  @@unique([companyId, number])
  @@index([companyId, saleDate])
  @@index([shiftId])
}

model PosSaleLine {
  id          String          @id @default(cuid())
  saleId      String
  sale        PosSale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  position    Int
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  code        String
  name        String
  quantity    Int
  unitPriceHT Decimal         @db.Decimal(12, 4) // 4 decimals: the shelf price incl. VAT is exact
  lineTotalHT Decimal         @db.Decimal(12, 2) // before the sale discount
  unitCost    Decimal         @default(0) @db.Decimal(12, 4) // average cost when sold
  refundLines PosRefundLine[]

  @@index([saleId])
}

/**
 * Goods brought back: stock goes back in and money goes out of the till (or card).
 */
model PosRefund {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  number    String // RF-2026-0001
  saleId    String
  sale      PosSale  @relation(fields: [saleId], references: [id])
  shiftId   String
  shift     PosShift @relation(fields: [shiftId], references: [id])
  cashierId String
  cashier   User     @relation(fields: [cashierId], references: [id])
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  reason    String
  totalHT   Decimal  @db.Decimal(12, 2)
  vatAmount Decimal  @db.Decimal(12, 2)
  totalTTC  Decimal  @db.Decimal(12, 2)
  method    String // CASH_USD | CASH_LBP | CARD
  rate      Decimal  @db.Decimal(14, 2)
  amountLbp Decimal  @default(0) @db.Decimal(16, 0) // LBP handed back (CASH_LBP)

  lines          PosRefundLine[]
  stockMovements StockMovement[]

  @@unique([companyId, number])
  @@index([saleId])
}

model PosRefundLine {
  id         String      @id @default(cuid())
  refundId   String
  refund     PosRefund   @relation(fields: [refundId], references: [id], onDelete: Cascade)
  saleLineId String
  saleLine   PosSaleLine @relation(fields: [saleLineId], references: [id])
  quantity   Int
  amountHT   Decimal     @db.Decimal(12, 2)

  @@index([refundId])
}

// ── Staff & payroll ──

/**
 * Someone on the payroll (doesn't need a login).
 */
model Employee {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  name         String
  position     String?
  phone        String?
  idNumber     String? // ID / NSSF number, printed on the payslip
  startDate    DateTime?     @db.Date
  payFrequency String // MONTHLY | WEEKLY
  baseSalary   Decimal       @db.Decimal(12, 2) // per month or per week, USD
  active       Boolean       @default(true)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  payrollLines PayrollLine[]
  nssfEnrolled Boolean       @default(true) // declared to the NSSF
  taxExemption Decimal       @default(0) @db.Decimal(12, 2) // yearly tax-free amount (family situation)

  @@index([companyId, active])
}

/**
 * One pay period (a month or a week): a line per employee, then approved and paid.
 */
model PayrollRun {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  number         String // PR-2026-0001
  frequency      String // MONTHLY | WEEKLY
  periodStart    DateTime       @db.Date
  periodEnd      DateTime       @db.Date
  label          String // "October 2026" | "Week of 19 Oct 2026"
  status         String         @default("DRAFT") // DRAFT | APPROVED | PAID
  payDate        DateTime?      @db.Date
  moneyAccountId String?
  moneyAccount   LedgerAccount? @relation(fields: [moneyAccountId], references: [id])
  notes          String?
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lines          PayrollLine[]

  @@unique([companyId, number])
  @@unique([companyId, frequency, periodStart])
}

model PayrollLine {
  id           String     @id @default(cuid())
  runId        String
  run          PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  name         String // snapshot at the time of the run
  position     String?
  baseSalary   Decimal    @db.Decimal(12, 2)
  bonus        Decimal    @default(0) @db.Decimal(12, 2)
  overtime     Decimal    @default(0) @db.Decimal(12, 2)
  deductions   Decimal    @default(0) @db.Decimal(12, 2) // absence, penalties: lower the salary cost
  advance      Decimal    @default(0) @db.Decimal(12, 2) // advance already given, paid back now
  net          Decimal    @db.Decimal(12, 2)
  note         String?
  nssfEmployee Decimal    @default(0) @db.Decimal(12, 2) // withheld from the salary
  nssfEmployer Decimal    @default(0) @db.Decimal(12, 2) // company cost (sickness, family, end of service)
  incomeTax    Decimal    @default(0) @db.Decimal(12, 2) // withheld from the salary

  @@unique([runId, employeeId])
}

// ── Vessels, workshop, warranties ──

/**
 * A customer's boat (shared by both companies, like customers).
 */
model Vessel {
  id           String         @id @default(cuid())
  name         String
  customerId   String?
  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  type         String? // Motor yacht, Sailing yacht, Fishing boat, RIB…
  make         String? // builder / brand
  model        String?
  lengthM      Decimal?       @db.Decimal(6, 2)
  year         Int?
  registration String? // registration / flag number
  hullNumber   String? // HIN
  homePort     String?
  notes        String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  engines      VesselEngine[]
  offers       Offer[]
  invoices     Invoice[]
  jobCards     JobCard[]
  warranties   Warranty[]
  appointments Appointment[]

  @@index([customerId])
  @@index([name])
}

model VesselEngine {
  id           String  @id @default(cuid())
  vesselId     String
  vessel       Vessel  @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  position     String // Port, Starboard, Main, Generator, Outboard…
  make         String?
  model        String?
  serialNumber String?
  year         Int?
  hours        Int? // last known running hours
  notes        String?

  @@index([vesselId])
  @@index([serialNumber])
}

/**
 * Work done on a boat. Without an offer it is invoiced itself; from an offer, the offer is billed.
 */
model JobCard {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  number         String // JC-2026-0001
  vesselId       String?
  vessel         Vessel?         @relation(fields: [vesselId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String
  offerId        String?
  offer          Offer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)
  status         String          @default("OPEN") // OPEN | IN_PROGRESS | DONE | CANCELLED
  complaint      String // what the customer reported / work requested
  workDone       String? // what was found and done
  technician     String?
  engineHours    Int?
  openedAt       DateTime        @db.Date
  dueDate        DateTime?       @db.Date
  completedAt    DateTime?       @db.Date
  applyVat       Boolean         @default(true)
  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lines          JobCardLine[]
  invoices       Invoice[]       @relation("JobCardInvoices")
  stockMovements StockMovement[]
  warrantyClaims WarrantyClaim[]
  appointments   Appointment[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([vesselId])
}

model JobCardLine {
  id          String   @id @default(cuid())
  jobCardId   String
  jobCard     JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  position    Int
  kind        String // PART | LABOR | SERVICE
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  title       String
  description String?
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2) // excl. VAT
  lineTotal   Decimal  @db.Decimal(12, 2)
  billable    Boolean  @default(true) // false: already covered by the offer
  unitCost    Decimal  @default(0) @db.Decimal(12, 4) // parts: average cost when used
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([jobCardId])
}

model Warranty {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  number       String // WR-2026-0001
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String
  vesselId     String?
  vessel       Vessel?         @relation(fields: [vesselId], references: [id], onDelete: SetNull)
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  item         String
  serialNumber String?
  startDate    DateTime        @db.Date
  endDate      DateTime        @db.Date
  terms        String?
  sourceType   String? // JOB_CARD | INVOICE | POS_SALE
  sourceId     String?
  sourceLabel  String? // e.g. JC-2026-0004
  status       String          @default("ACTIVE") // ACTIVE | VOID
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  claims       WarrantyClaim[]

  @@unique([companyId, number])
  @@index([serialNumber])
  @@index([companyId, endDate])
}

model WarrantyClaim {
  id          String   @id @default(cuid())
  warrantyId  String
  warranty    Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  description String
  status      String   @default("OPEN") // OPEN | ACCEPTED | REJECTED | RESOLVED
  resolution  String?
  jobCardId   String?
  jobCard     JobCard? @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([warrantyId])
}

// ── Stock counts and transfers between the two companies ──

model StockCount {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  number         String // SC-2026-0001
  countDate      DateTime         @db.Date
  status         String           @default("DRAFT") // DRAFT | POSTED
  notes          String?
  createdById    String
  createdBy      User             @relation(fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  postedAt       DateTime?
  lines          StockCountLine[]
  stockMovements StockMovement[]

  @@unique([companyId, number])
}

model StockCountLine {
  id        String     @id @default(cuid())
  countId   String
  count     StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id])
  expected  Int // system quantity when the count started
  counted   Int? // null = not counted yet

  @@unique([countId, productId])
}

/**
 * Goods sent from one company to the other, valued at cost; received by the other side.
 */
model StockTransfer {
  id             String              @id @default(cuid())
  number         String              @unique // TF-2026-0001
  fromCompanyId  String
  fromCompany    Company             @relation("TransferFrom", fields: [fromCompanyId], references: [id])
  toCompanyId    String
  toCompany      Company             @relation("TransferTo", fields: [toCompanyId], references: [id])
  status         String              @default("SENT") // SENT | RECEIVED | CANCELLED
  sentDate       DateTime            @db.Date
  receivedDate   DateTime?           @db.Date
  notes          String?
  totalCost      Decimal             @db.Decimal(12, 2)
  createdById    String
  createdBy      User                @relation("TransferCreatedBy", fields: [createdById], references: [id])
  receivedById   String?
  receivedBy     User?               @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  createdAt      DateTime            @default(now())
  lines          StockTransferLine[]
  stockMovements StockMovement[]

  @@index([fromCompanyId])
  @@index([toCompanyId])
}

model StockTransferLine {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal       @db.Decimal(12, 2)
  lineTotal  Decimal       @db.Decimal(12, 2)

  @@index([transferId])
}

// ── Costing, serial numbers, cheques, bank reconciliation ──

/**
 * Freight, customs, clearing… spread over a purchase's items to get their real cost.
 */
model LandedCost {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal  @db.Decimal(12, 2) // excl. VAT
  createdAt   DateTime @default(now())

  @@index([purchaseId])
}

/**
 * One unit of a serial-tracked product (an engine, an outboard…), from purchase to customer.
 */
model ProductSerial {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  companyId    String // company holding it (or that sold it)
  company      Company   @relation(fields: [companyId], references: [id])
  serialNumber String
  status       String    @default("IN_STOCK") // IN_STOCK | SOLD | RETURNED | SCRAPPED
  purchaseId   String?
  purchase     Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String?
  vesselId     String?
  soldAt       DateTime? @db.Date
  soldRef      String? // e.g. POS-2026-00012, JC-2026-0004, XM-INV-2026-0010
  notes        String?
  createdAt    DateTime  @default(now())

  @@unique([productId, serialNumber])
  @@index([companyId, status])
  @@index([serialNumber])
}

/**
 * A cheque received from a customer or given to a supplier, usually post-dated.
 */
model Cheque {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  number            String // CQ-2026-0001
  direction         String // RECEIVED | ISSUED
  chequeNumber      String
  bank              String?
  partyName         String
  customerId        String?
  customer          Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId        String?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  amount            Decimal          @db.Decimal(12, 2)
  issueDate         DateTime         @db.Date
  dueDate           DateTime         @db.Date
  status            String // RECEIVED: IN_HAND | DEPOSITED | CLEARED | BOUNCED ; ISSUED: ISSUED | CLEARED | BOUNCED ; both: CANCELLED
  receiptId         String?
  receipt           CustomerReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  supplierPaymentId String?
  supplierPayment   SupplierPayment? @relation(fields: [supplierPaymentId], references: [id], onDelete: SetNull)
  bankAccountId     String?
  bankAccount       LedgerAccount?   @relation(fields: [bankAccountId], references: [id])
  clearedAt         DateTime?        @db.Date
  notes             String?
  createdById       String
  createdBy         User             @relation(fields: [createdById], references: [id])
  createdAt         DateTime         @default(now())

  @@unique([companyId, number])
  @@index([companyId, status, dueDate])
}

/**
 * A bank statement matched against the ledger: lines ticked here are "on the statement".
 */
model BankReconciliation {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id])
  accountId        String
  account          LedgerAccount @relation(fields: [accountId], references: [id])
  statementDate    DateTime      @db.Date
  statementBalance Decimal       @db.Decimal(14, 2)
  createdById      String
  createdBy        User          @relation(fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  lines            JournalLine[]

  @@index([companyId, accountId])
}

/**
 * A visit booked by a customer from the portal (or by staff): confirmed, then usually a job card.
 */
model Appointment {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  number        String // AP-2026-0001
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  phone         String?
  vesselId      String?
  vessel        Vessel?   @relation(fields: [vesselId], references: [id], onDelete: SetNull)
  reason        String // what the customer needs
  requestedDate DateTime  @db.Date
  requestedTime String // "09:00"
  date          DateTime  @db.Date // confirmed (or requested) date
  time          String
  status        String    @default("REQUESTED") // REQUESTED | CONFIRMED | DONE | DECLINED | CANCELLED
  source        String    @default("PORTAL") // PORTAL | STAFF
  customerNote  String?
  staffNote     String?
  jobCardId     String?
  jobCard       JobCard?  @relation(fields: [jobCardId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([companyId, number])
  @@index([companyId, date])
}

/**
 * Who created, changed or deleted what, and when (written automatically).
 */
model AuditLog {
  id        String   @id @default(cuid())
  companyId String? // null: shared records (products, customers, suppliers, vessels)
  userId    String?
  userName  String?
  action    String // CREATE | UPDATE | DELETE
  entity    String // Invoice, Offer, Product…
  entityId  String?
  label     String? // e.g. XM-INV-2026-0003, a product name
  details   String? // what changed
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entity, entityId])
}

/**
 * NSSF and income-tax rules for a company's payroll (set by the accountant).
 */
model PayrollSettings {
  id               String  @id @default(cuid())
  companyId        String  @unique
  company          Company @relation(fields: [companyId], references: [id])
  sicknessEmployee Decimal @default(3) @db.Decimal(6, 3) // % of salary (up to the ceiling)
  sicknessEmployer Decimal @default(8) @db.Decimal(6, 3)
  sicknessCap      Decimal @default(0) @db.Decimal(12, 2) // monthly ceiling in USD, 0 = none
  familyEmployer   Decimal @default(6) @db.Decimal(6, 3)
  familyCap        Decimal @default(0) @db.Decimal(12, 2)
  endOfService     Decimal @default(8.5) @db.Decimal(6, 3) // employer, no ceiling
  taxBrackets      String  @default("") // one per line: "<annual USD up to> <rate %>", last line may be "* <rate %>"
  defaultExemption Decimal @default(0) @db.Decimal(12, 2) // yearly tax-free amount for a new employee
}

/**
 * Standard clauses (payment, delivery, warranty…) to insert into offers.
 */
model OfferClause {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  title     String
  text      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([companyId])
}

// What the till allows, set by the admin / manager for each company with a counter.
// "Cashier" limits apply to the CASHIER role; managers, accountants and admins are not limited.
model PosSettings {
  id                     String   @id @default(cuid())
  companyId              String   @unique
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  maxDiscountPct         Decimal  @default(10) @db.Decimal(5, 2) // cashier's largest discount
  allowUsd               Boolean  @default(true)
  allowLbp               Boolean  @default(true)
  allowCard              Boolean  @default(true)
  cardOverpay            String   @default("BLOCK") // BLOCK | CHANGE (give the extra back in cash)
  sellOutOfStock         Boolean  @default(true) // cashier may sell more than the stock shows
  customerRequiredAbove  Decimal  @default(0) @db.Decimal(12, 2) // USD incl. VAT; 0 = never
  cashierRefunds         Boolean  @default(true)
  refundDays             Int      @default(0) // cashier refunds only within N days; 0 = any time
  blindClose             Boolean  @default(false) // cashier counts the drawer without seeing the expected cash
  cashierSeesShiftTotals Boolean  @default(true)
  receiptNote            String? // printed at the bottom of the receipt
  updatedAt              DateTime @updatedAt
}

// Deleted records, kept so they can be restored: the record and everything removed with it
// (lines, journal entries, stock movements) as rows per table. Emptied with the database.
model RecycleBinItem {
  id             String    @id @default(cuid())
  companyId      String?
  entity         String // "Invoice", "Voucher"… (the main model)
  entityId       String
  label          String // what the user sees, e.g. "Voucher PV-2026-0003 · $120.00"
  rows           Json // { [model]: row[] }, inserted back parents first
  relinks        Json? // rows whose link to the record was set to empty: { model, id, field, value }[]
  deletedByName  String
  deletedAt      DateTime  @default(now())
  restoredAt     DateTime?
  restoredByName String?

  @@index([companyId, deletedAt])
}

// ── Public website (Marketing → Website), one per company ──

model WebsiteSettings {
  id             String   @id @default(cuid())
  companyId      String   @unique
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  published      Boolean  @default(false) // off: the public site shows "coming soon"
  tagline        String?
  heroTitle      String?
  heroText       String?
  heroImageId    String?
  aboutTitle     String?
  aboutText      String?
  aboutImageId   String?
  highlights     String? // one per line: "Title | short text"
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  mapQuery       String? // what to show on the map, e.g. "Jounieh marina, Lebanon"
  openingHours   String? // one per line
  facebook       String?
  instagram      String?
  linkedin       String?
  seoTitle       String?
  seoDescription String?
  showCatalogue  Boolean  @default(true)
  showGallery    Boolean  @default(true)
  showBooking    Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model WebsiteService {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String
  imageId     String?
  position    Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([companyId, position])
}

model WebsiteGalleryItem {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  caption   String?
  imageId   String
  position  Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([companyId, position])
}

// Website settings for one product of a company's catalogue. Products appear on the website
// automatically (those the company stocks or bought); this row only hides, features or adds a
// website photo / description. No prices are shown ("Ask for a quote").
model WebsiteListing {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  hidden      Boolean  @default(false)
  featured    Boolean  @default(false)
  description String? // website text; empty = the product's description
  imageId     String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([companyId, productId])
}

// Pictures for the websites, kept in the database (resized in the browser before upload).
model WebsiteImage {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  @@index([companyId])
}

// Contact messages, quote requests and booking requests sent from the website.
model WebsiteMessage {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind          String // CONTACT | QUOTE | BOOKING
  name          String
  email         String?
  phone         String?
  message       String
  productId     String?
  productName   String?
  appointmentId String?
  status        String    @default("NEW") // NEW | HANDLED
  handledAt     DateTime?
  handledByName String?
  ipHash        String? // to slow down spam (never the address itself)
  createdAt     DateTime  @default(now())

  @@index([companyId, createdAt])
}
